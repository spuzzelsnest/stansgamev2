# One rule per line. A rule on the same line as a comment is ignored.
# Paths starting with / are relative to the repository root, where the Unity project lives.

# ---------- Unity generated (never commit; Unity rebuilds these) ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Same folders when the Unity project sits one folder down (for example /StansGame/Library/)
/*/[Ll]ibrary/
/*/[Tt]emp/
/*/[Oo]bj/
/*/[Bb]uild/
/*/[Bb]uilds/
/*/[Ll]ogs/
/*/[Uu]ser[Ss]ettings/
/*/[Mm]emoryCaptures/
/*/[Rr]ecordings/
# ...but never a folder that sits directly in Assets/, Packages/, ProjectSettings/ or the repo's own folders
!/[Aa]ssets/*/
!/[Pp]ackages/*/
!/[Pp]roject[Ss]ettings/*/
!/3d-model/*/
!/vault/*/

# Local backups made by tools/join-repo.ps1
*.before-join

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity crash reports and build artefacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Player builds made outside Build/ (Windows standalone output). Builds ship as GitHub Releases, never as commits.
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
/*_Data/
/MonoBleedingEdge/
/D3D12/
/*.exe
/UnityPlayer.dll
/UnityCrashHandler*.exe
/StansGame_*.zip

# ---------- IDE and solution files (Unity regenerates them) ----------
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.swp

# ---------- Blender backups ----------
*.blend1
*.blend2
*.blend@

# ---------- Obsidian (keep notes and shared config, drop per-user state) ----------
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# ---------- Claude Code (per-user settings) ----------
.claude/settings.local.json
CLAUDE.local.md

# ---------- Source material that stays out of the repo (raw scans, LiDAR tiles, aerial photos) ----------
/_downloads/

# ---------- OS junk ----------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Level blockout raw downloads (IGN tiles, never committed)
**/_downloads/

# Python bytecode
__pycache__/
*.pyc
