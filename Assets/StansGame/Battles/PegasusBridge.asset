  defender:
    name: Bridge garrison, 736th Grenadier Regiment
    faction: 1
    notes: 
    commander:
      name: Hans Schmidt
      rank: Major
      unit: "Garrison of the B\xE9nouville and Ranville bridges, 736th Grenadier Regiment, 716th Infantry Division"
      portrait: {fileID: 2800000, guid: cb680754b1bfaec47b7b4b162370c426, type: 3}
      bio: Commanded the understrength company guarding the two bridges. He was away in Ranville when the gliders landed, and drove to the bridge afterwards, where he was wounded and taken prisoner.
      reinforceBelow: 0.6
