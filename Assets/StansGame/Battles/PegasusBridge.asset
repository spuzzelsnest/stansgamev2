  m_Name: PegasusBridge
  m_EditorClassIdentifier: Assembly-CSharp::StansGame.BattlePlan
  level: PegasusBridge
  notes: Written from the level as the builder placed it. Positions, facing and skill set here are applied on every rebuild.
  attacker:
    name: D Company, 2nd Ox and Bucks
    faction: 0
    notes: 
    commander:
      name: John Howard
      rank: Major
      unit: D Company, 2nd Oxfordshire and Buckinghamshire Light Infantry (glider-borne)
      portrait: {fileID: 2800000, guid: 4b93378a8ab4f7041ae69a566aa08a43, type: 3}
      bio: Led the six Horsa gliders of D Company, with sappers of the Royal Engineers, onto the bridges over the Caen Canal and the Orne just after midnight on 6 June, and held them until relieved.
      reinforceBelow: 0.6
      fallBackBelow: 0.3
      maxSend: 3
      bounding: 1
      boundSeconds: 7
      regroupBelow: 0.4
      orderInterval: 3
