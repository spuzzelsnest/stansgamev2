  m_Script: {fileID: 11500000, guid: 2599ca87022ed3a4cb7311c4366b2b4d, type: 3}
  m_Name: SainteMereEglise
  m_EditorClassIdentifier: Assembly-CSharp::StansGame.BattlePlan
  level: SainteMereEglise
  notes: Night of 5/6 June 1944. The 505th PIR drops on and around the town; the German garrison is out in the square with the townspeople fighting the fire at the Pommier house. By 04:00 the 3rd Battalion (Krause) holds the town; the Germans counter-attack from Carentan (south) and Neuville (north) during the day.
  attacker:
    name: 505th PIR, 82nd Airborne
    faction: 0
    notes: F Company's stick (the player's) jumps into the town; the 3rd Battalion gathers in the orchard west of it.
    commander:
      name: Edward C. Krause
      rank: Lieutenant Colonel
      unit: 3rd Battalion, 505th Parachute Infantry Regiment, 82nd Airborne
      portrait: {fileID: 0}
      bio: "Commanded the 3rd Battalion of the 505th. Gathered his scattered men west of the town in the dark and took Sainte-M\xE8re-\xC9glise before dawn on 6 June; the American flag went up at the town hall, making it one of the first towns freed in Normandy."
      reinforceBelow: 0.6
      fallBackBelow: 0.3
      maxSend: 3
      bounding: 1
      boundSeconds: 7
      regroupBelow: 0.4
      orderInterval: 3
    groups:
    - id: stick
      name: F Company, 2/505 - the player's stick
      task: Jump from the C-47 over the town. Position = where each man lands (the 'Player' entry is the player's place in the door).
